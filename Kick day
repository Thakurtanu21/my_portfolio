<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kick Day Celebration</title>
    <style>
        body {
            text-align: center;
            background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
            color: white;
            font-family: Arial, sans-serif;
            overflow: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 20px;
        }

        #countdown {
            font-size: 1.5rem;
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.2);
            padding: 10px 20px;
            border-radius: 10px;
        }

        .kick-container {
            position: relative;
            width: 200px;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .football {
            width: 100px;
            cursor: pointer;
            transition: transform 0.2s ease-in-out;
        }

        .kick-animation {
            animation: kick 0.5s ease-in-out;
        }

        @keyframes kick {
            0% { transform: translateY(0) rotate(0); }
            50% { transform: translateY(-150px) rotate(360deg); }
            100% { transform: translateY(0) rotate(0); }
        }

        .floating-football {
            position: absolute;
            font-size: 30px;
            animation: floatUp 5s linear infinite;
        }

        @keyframes floatUp {
            0% { transform: translateY(0); opacity: 1; }
            100% { transform: translateY(-100vh); opacity: 0; }
        }

        button {
            background: white;
            color: #2c5364;
            font-size: 1.2rem;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s;
            margin-top: 20px;
        }

        button:hover {
            background: #2c5364;
            color: white;
        }

    </style>
</head>
<body>

    <h1>Happy Kick Day! ⚽</h1>
    <div id="countdown"></div>

    <div class="kick-container">
        <img src="https://upload.wikimedia.org/wikipedia/commons/e/ec/Football_iu_1996.jpg" alt="Football" class="football" id="football">
    </div>

    <button onclick="kickBall()">Kick the Ball!</button>

    <audio id="kickSound" src="https://www.fesliyanstudios.com/play-mp3/4383" preload="auto"></audio>

    <script>
        // Kick Ball Animation and Sound
        function kickBall() {
            let football = document.getElementById("football");
            let kickSound = document.getElementById("kickSound");
            football.classList.add("kick-animation");
            kickSound.play();

            setTimeout(() => {
                football.classList.remove("kick-animation");
            }, 500);
        }

        // Countdown Timer for Kick Day (February 16)
        function updateCountdown() {
            let eventDate = new Date("February 16, 2025 00:00:00").getTime();
            let now = new Date().getTime();
            let diff = eventDate - now;

            let days = Math.floor(diff / (1000 * 60 * 60 * 24));
            let hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            let minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            let seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById("countdown").innerHTML = `Kick Day in: ${days}d ${hours}h ${minutes}m ${seconds}s`;

            if (diff < 0) {
                document.getElementById("countdown").innerHTML = "Happy Kick Day!";
            }
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Create Floating Footballs
        function createFloatingFootball() {
            const football = document.createElement("div");
            football.className = "floating-football";
            football.innerHTML = "⚽";
            document.body.appendChild(football);

            let randomX = Math.random() * window.innerWidth;
            football.style.left = `${randomX}px`;

            setTimeout(() => { football.remove(); }, 5000);
        }

        setInterval(createFloatingFootball, 700);
    </script>

</body>
</html>
